/* ── Imprimir malla como PDF ── */
function imprimirMalla(){
    cerrarMenus();
    const tab=tabs.find(t=>t.id===activeTabId);
    const mg=tab?document.getElementById('mg-'+tab.id):null;

    // ── Construir leyenda de colores ───────────────────────────────────
    const orden = (typeof etiquetaOrder!=='undefined' ? etiquetaOrder : Object.keys(etiquetaStyles||{}).filter(k=>k!=='default'));
    const estilos = typeof etiquetaStyles!=='undefined' ? etiquetaStyles : {};
    const chips = orden.map(function(k){
        const s = estilos[k] || {bg:'#7f8c8d',fg:'#ffffff'};
        const label = k.replace(/_/g,' ');
        return '<span style="display:inline-block;padding:2px 9px;border-radius:10px;font-size:10px;font-weight:700;'+
               'background:'+s.bg+';color:'+s.fg+';-webkit-print-color-adjust:exact;print-color-adjust:exact;">'+
               label+'</span>';
    }).join('');
    const leyEl = document.createElement('div');
    leyEl.id = '_print_ley';
    leyEl.style.cssText = 'display:flex;flex-wrap:wrap;align-items:center;gap:5px;'+
        'padding:6px 4px 0 4px;border-top:1px solid #ccc;margin-top:8px;font-family:inherit;';
    leyEl.innerHTML = '<span style="font-size:11px;font-weight:700;color:#555;margin-right:4px;">Leyenda:</span>'+chips;

    if(mg){
        // Calcular escala para que la grilla quepa en una página A4 horizontal
        // A4 landscape - márgenes 1cm ≈ 1060×688 px (a 96dpi), ~32px reservados para leyenda
        const PW=1060, PH=688;

        // Medir el contenido real sumando las columnas (evita incluir área vacía del contenedor)
        const cols = Array.from(mg.querySelectorAll(':scope > .semestre-col'));
        let gw, gh;
        if(cols.length){
            gw = cols.reduce(function(s,c){
                const m=getComputedStyle(c);
                return s+c.offsetWidth+(parseFloat(m.marginLeft)||0)+(parseFloat(m.marginRight)||0);
            },0);
            // Para el alto: offsetHeight de la columna más alta (no scrollHeight,
            // que incluiría el overflow oculto del contenedor de pantalla)
            gh = cols.reduce(function(m,c){return Math.max(m,c.offsetHeight);},0);
        } else {
            gw = mg.scrollWidth;
            gh = mg.offsetHeight;
        }

        // Escalar preferentemente al ancho; caer en alto solo si la malla es muy alta
        const scaleW=PW/gw, scaleH=PH/gh;
        const scale = scaleW*gh <= PH ? scaleW : scaleH;

        // Usar zoom en vez de transform:scale — zoom afecta el layout, por lo que
        // el espacio ocupado en la página se colapsa al tamaño real del contenido escalado.
        const st=document.createElement('style');
        st.id='_ps';
        st.textContent=
            '@media print{'+
            '.malla-grid{zoom:'+scale.toFixed(4)+' !important;}'+
            '.malla-scroll-container,.malla-area,.panel-inner,.panel,.workspace,.tab-content-wrapper'+
            '{height:auto !important;overflow:visible !important;}'+
            '#_print_ley{display:flex !important;}'+
            '}';
        document.head.appendChild(st);

        // Insertar leyenda después del contenedor de la grilla
        const container = mg.closest('.malla-scroll-container') || mg.closest('.malla-area') || mg.parentElement;
        if(container && container.parentElement) container.parentElement.appendChild(leyEl);
        else document.body.appendChild(leyEl);

        window.print();
        setTimeout(function(){
            const s=document.getElementById('_ps'); if(s) s.remove();
            const l=document.getElementById('_print_ley'); if(l) l.remove();
        },1500);
    } else {
        document.body.appendChild(leyEl);
        window.print();
        setTimeout(function(){const l=document.getElementById('_print_ley');if(l)l.remove();},1500);
    }
}

