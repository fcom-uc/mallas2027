   ================================================================ */
function abrirCfg(tabId){
    cerrarMenus();
    cfgTabId=tabId;
    const tab=tabs.find(t=>t.id===tabId);
    const prog=db.Programas[tab.progKey];
    document.getElementById('cfg-titulo').textContent='Parámetros — '+prog.Nombre;
    document.getElementById('cfg-nombre').value=prog.Nombre||'';
    document.getElementById('cfg-clave').value=tab.progKey;
    document.getElementById('cfg-sem').value=prog.SemestresMaximos;
    document.getElementById('cfg-cred').value=prog.CreditosMaximos;
    document.getElementById('cfg-overlay').classList.add('open');
    document.getElementById('cfg-nombre').focus();
}
function cerrarCfg(){document.getElementById('cfg-overlay').classList.remove('open');cfgTabId=null;}
function cerrarCfgSiOverlay(e){if(e.target===document.getElementById('cfg-overlay'))cerrarCfg();}
function guardarCfg(){
    if(!cfgTabId)return;
    const tab=tabs.find(t=>t.id===cfgTabId);
    const viejaClave=tab.progKey;
    const nuevoNombre=document.getElementById('cfg-nombre').value.trim();
    const nuevaClave=document.getElementById('cfg-clave').value.trim().toUpperCase();
    const ns=parseInt(document.getElementById('cfg-sem').value,10);
    const nc=parseInt(document.getElementById('cfg-cred').value,10);
    if(!nuevoNombre){alert('El nombre no puede estar vacío.');return;}
    if(!nuevaClave){alert('El código no puede estar vacío.');return;}
    if(isNaN(ns)||ns<1){alert('Semestres debe ser positivo.');return;}
    if(isNaN(nc)||nc<1){alert('Créditos debe ser positivo.');return;}
    if(nuevaClave!==viejaClave){
        if(db.Programas[nuevaClave]){alert('Ya existe un programa con el código "'+nuevaClave+'".');return;}
        db.Programas[nuevaClave]=db.Programas[viejaClave];
        delete db.Programas[viejaClave];
        tab.progKey=nuevaClave;
        PROG_KEYS=Object.keys(db.Programas);
    }
    const prog=db.Programas[tab.progKey];
    prog.Nombre=nuevoNombre;
    Object.values(prog.Cursos).forEach(l=>{if(l.Semestre&&l.Semestre>ns)l.Semestre=null;});
    prog.SemestresMaximos=ns;prog.CreditosMaximos=nc;
    const id=cfgTabId;cerrarCfg();
    const t=tabs.find(t=>t.id===id);
    t.sortables.forEach(s=>{try{s.destroy();}catch(_){}});t.sortables=[];
    renderTabStrip();
    buildGrid(id);renderCursos(id);initSortable(id);recalcularTodo(id);
    programarGuardado();
}

