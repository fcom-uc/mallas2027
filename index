/* ================================================================
   DATOS: cursos del programa
   ================================================================ */
function cursosDisponibles(progKey){
    const locales=db.Programas[progKey].Cursos||{};
    const res=[];
    Object.entries(db.Cursos).forEach(([cod,global])=>{
        const local=locales[cod];
        if(!local||!local.Semestre){
            res.push({Codigo:cod,Nombre:global.Nombre||'',Creditos:global.Creditos||0,
                Prerrequisitos:global.Prerrequisitos||[],Comentarios:global.Comentarios||'',
                Etiqueta:local?.Etiqueta||'PC',Semestre:null,Capa:local?.Capa||0,enPrograma:!!local});
        }
    });
    res.sort((a,b)=>a.Nombre.localeCompare(b.Nombre,'es'));
    return res;
}
function cursosEnMalla(progKey){
    const locales=db.Programas[progKey].Cursos||{};
    return Object.entries(locales).filter(([,l])=>l.Semestre).map(([cod,local])=>{
        const global=db.Cursos[cod]||{};
        return{Codigo:cod,Nombre:global.Nombre||'',Creditos:global.Creditos||0,
            Prerrequisitos:global.Prerrequisitos||[],Comentarios:global.Comentarios||'',
            Etiqueta:local.Etiqueta||'PC',Semestre:local.Semestre,Capa:local.Capa||0};
    });
}
function cursosDelPrograma(progKey){return[...cursosDisponibles(progKey),...cursosEnMalla(progKey)];}

/* ================================================================
   RENDERIZADO DE CURSOS
   ================================================================ */
function renderCursos(tabId){
    const tab=tabs.find(t=>t.id===tabId);
    const prog=db.Programas[tab.progKey];
    document.getElementById('bl-'+tabId).innerHTML='';
    for(let i=1;i<=prog.SemestresMaximos;i++){const b=document.getElementById('sb-'+tabId+'-'+i);if(b)b.innerHTML='';}
    const todos=cursosDelPrograma(tab.progKey);
    cursosDisponibles(tab.progKey).forEach(curso=>{
        document.getElementById('bl-'+tabId)?.appendChild(crearCard(curso,todos,tabId,true));
    });
    cursosEnMalla(tab.progKey).sort((a,b)=>(b.Capa||0)-(a.Capa||0)).forEach(curso=>{
        document.getElementById('sb-'+tabId+'-'+curso.Semestre)?.appendChild(crearCard(curso,todos,tabId,false));
    });
}

function crearCard(curso,todos,tabId,mostrarEliminar){
    const card=document.createElement('div');
    const etKey=(curso.Etiqueta||'').toLowerCase();
    const et=Object.keys(etiquetaStyles).includes(etKey)?etKey:'default';
    // En el backlog usamos siempre gris claro independientemente de la etiqueta
    card.className='curso-card '+(mostrarEliminar?'card-backlog':'card-'+et);
    card.setAttribute('data-codigo',curso.Codigo);
    card.addEventListener('dblclick',e=>{e.stopPropagation();if(impactoActivo)resaltarArbol(curso.Codigo);else abrirModal(curso.Codigo,tabId);});
    const deps=(todos||[]).filter(c=>c.Prerrequisitos?.includes(curso.Codigo)).map(c=>c.Codigo);
    const tt='Requisitos: '+prereqLabel(curso)+
             '\nEs requisito de: '+(deps.length>0?deps.join(', '):'ninguno');
    const pdfUrl=urlPrograma(curso.Codigo);
    const pdfIcon='<a class="pdf-link" href="'+pdfUrl+'" target="_blank" rel="noopener" title="Programa: '+esc(pdfUrl)+'">'
        +'<svg width="13" height="13" viewBox="0 0 13 13" fill="none" xmlns="http://www.w3.org/2000/svg">'
        +'<path d="M5 2H2a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>'
        +'<path d="M8 1h4v4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>'
        +'<path d="M12 1L6 7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>'
        +'</svg></a>';
    card.innerHTML=
        '<div class="error-badge" title="Violación de prerrequisito">!</div>'+
        '<div class="cycle-badge" title="Ciclo de prerrequisitos">∞</div>'+
        pdfIcon+
        (mostrarEliminar?'<button class="delete-card-btn" title="Quitar del programa">−</button>':'')+
        '<div class="curso-code">'+esc(curso.Codigo)+' ['+esc(curso.Etiqueta)+']</div>'+
        '<div class="curso-name" title="'+esc(tt)+'">'+esc(curso.Nombre)+'</div>'+
        '<div class="curso-footer"><span>'+curso.Creditos+' Cred.</span></div>';
    card.querySelector('.pdf-link').addEventListener('click',function(e){
        e.stopPropagation();
        if(dirProgramas){e.preventDefault();abrirProgramaLocal(curso.Codigo,pdfUrl);}
    });
    if(mostrarEliminar){
        card.querySelector('.delete-card-btn').addEventListener('click',function(e){
            e.stopPropagation();
            quitarCursoDelPrograma(e,curso.Codigo,tabId);
        });
    }
    return card;
}

/* ================================================================
   CREAR / QUITAR CURSOS
   ================================================================ */
function crearCursoNuevo(tabId){
    cerrarMenus();
    const tab=tabs.find(t=>t.id===tabId);
    let n=Object.keys(db.Cursos).length+1,codigo;
    do{codigo='NUEVO_'+n++;}while(db.Cursos[codigo]);
    db.Cursos[codigo]={Nombre:'Nuevo curso',Creditos:10,Prerrequisitos:[],Comentarios:''};
    db.Programas[tab.progKey].Cursos[codigo]={Etiqueta:'PC',Semestre:null,Capa:0};
    const todos=cursosDelPrograma(tab.progKey);
    const curso=todos.find(c=>c.Codigo===codigo);
    document.getElementById('bl-'+tabId)?.prepend(crearCard(curso,todos,tabId,true));
    recalcularTodo(tabId);
    abrirModal(codigo,tabId);
    programarGuardado();
}

function quitarCursoDelPrograma(e,codigo,tabId){
    tabId=parseInt(tabId,10);
    e.stopPropagation();
    const tab=tabs.find(t=>t.id===tabId);
    const nombre=db.Cursos[codigo]?.Nombre||codigo;
    const enOtros=PROG_KEYS.filter(pk=>pk!==tab.progKey&&db.Programas[pk].Cursos?.[codigo]);
    // Pregunta 1: quitar del programa actual
    const msg1=enOtros.length>0
        ?'¿Quitar "'+nombre+'" de este programa?\n(El curso permanece en el catálogo y en: '+enOtros.join(', ')+')'
        :'¿Quitar "'+nombre+'" de este programa?';
    if(!confirm(msg1))return;
    delete db.Programas[tab.progKey].Cursos[codigo];
    // Pregunta 2: si no queda en ningún programa, ofrecer eliminar del catálogo
    const quedaEnAlguno=PROG_KEYS.some(pk=>db.Programas[pk].Cursos?.[codigo]);
    if(!quedaEnAlguno){
        if(confirm('"'+nombre+'" ya no está en ninguna malla.\n¿Eliminarlo también del catálogo global?')){
            delete db.Cursos[codigo];
            Object.values(db.Cursos).forEach(c=>{
                if(Array.isArray(c.Prerrequisitos))c.Prerrequisitos=c.Prerrequisitos.filter(r=>r!==codigo);
                if(c.PrerrequisitosExpr&&prereqCodigos(c.PrerrequisitosExpr).includes(codigo))delete c.PrerrequisitosExpr;
            });
        }
    }
    document.querySelector('#panel-'+tabId+' [data-codigo="'+CSS.escape(codigo)+'"]')?.remove();
    recalcularTodo(tabId);
    programarGuardado();
}

/* ================================================================
   SORTABLE
   ================================================================ */
function initSortable(tabId){
    const tab=tabs.find(t=>t.id===tabId);
    const prog=db.Programas[tab.progKey];
    const opts={
        group:'malla-'+tabId,animation:150,ghostClass:'sortable-ghost',
        onEnd:function(evt){
            const codigo=evt.item.getAttribute('data-codigo');
            const sem=parseInt(evt.to.getAttribute('data-semestre'));
            if(sem===0){
                // Arrastrado al backlog: eliminar del programa
                delete db.Programas[tab.progKey].Cursos[codigo];
            } else {
                // Arrastrado a un semestre: asignar o crear entrada
                if(!db.Programas[tab.progKey].Cursos[codigo])
                    db.Programas[tab.progKey].Cursos[codigo]={Etiqueta:'PC',Capa:0};
                db.Programas[tab.progKey].Cursos[codigo].Semestre=sem;
            }
            sincronizarCapas(tabId);
            const todos=cursosDelPrograma(tab.progKey);
            const curso=todos.find(c=>c.Codigo===codigo);
            const cardNueva=crearCard(curso,todos,tabId,sem===0);
            evt.item.parentNode.replaceChild(cardNueva,evt.item);
            recalcularTodo(tabId);
            programarGuardado();
        }
    };
    tab.sortables.push(Sortable.create(document.getElementById('bl-'+tabId),opts));
    for(let i=1;i<=prog.SemestresMaximos;i++){
        const el=document.getElementById('sb-'+tabId+'-'+i);
        if(el)tab.sortables.push(Sortable.create(el,opts));
    }
}

/* ================================================================
   LÓGICA DE NEGOCIO
   ================================================================ */
function sincronizarCapas(tabId){
    const tab=tabs.find(t=>t.id===tabId);
    const prog=db.Programas[tab.progKey];
    for(let i=1;i<=prog.SemestresMaximos;i++){
        const cont=document.getElementById('sb-'+tabId+'-'+i);if(!cont)continue;
        let capa=10;
        cont.querySelectorAll('.curso-card').forEach(card=>{
            const cod=card.getAttribute('data-codigo');
            if(prog.Cursos[cod]){prog.Cursos[cod].Capa=capa;capa=Math.max(0,capa-1);}
        });
    }
    // Cursos sin semestre asignado = fuera de la malla → eliminar del programa
    Object.keys(prog.Cursos).forEach(cod=>{
        if(!prog.Cursos[cod].Semestre) delete prog.Cursos[cod];
    });
}

function recalcularTodo(tabId){
    const tab=tabs.find(t=>t.id===tabId);
    const prog=db.Programas[tab.progKey];
    const enMalla=cursosEnMalla(tab.progKey);
    let total=0;
    const cps=Array(prog.SemestresMaximos+1).fill(0);
    enMalla.forEach(c=>{cps[c.Semestre]=(cps[c.Semestre]||0)+c.Creditos;total+=c.Creditos;});
    for(let s=1;s<=prog.SemestresMaximos;s++){
        const ind=document.getElementById('cr-'+tabId+'-'+s);
        const col=document.getElementById('sc-'+tabId+'-'+s);
        if(ind)ind.innerText=cps[s]+' / '+prog.CreditosMaximos+' cr.';
        if(col)col.classList.toggle('error-limit',cps[s]>prog.CreditosMaximos);
    }
    const tel=document.getElementById('tc-'+tabId);if(tel)tel.innerText=total;
    enMalla.forEach(curso=>{
        const card=document.querySelector('#panel-'+tabId+' [data-codigo="'+CSS.escape(curso.Codigo)+'"]');
        if(!card)return;
        let err=false;
        const aprobados=new Set(enMalla.filter(c=>c.Semestre<curso.Semestre).map(c=>c.Codigo));
        if((curso.Prerrequisitos?.length>0)||curso.PrerrequisitosExpr){
            err=!prereqSatisfied(curso,aprobados);
        }
        card.classList.toggle('violacion-requisito',err);
    });
    actualizarStatsEtiquetas(tabId);
    if(impactoActivo)aplicarImpacto(tabId);
    detectarCiclos(tabId);
}

