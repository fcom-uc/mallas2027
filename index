/* ── Prerrequisitos con lógica y/o ── */
function prereqCodigos(expr){
    // Extrae todos los códigos de una expresión (string o array legacy)
    if(!expr)return[];
    if(Array.isArray(expr))return expr;
    return expr.match(/[A-Z][A-Z0-9_]*/g)||[];
}
function _esExprCompleja(s){return typeof s==='string'&&/\bo\b|\(/i.test(s);}
function prereqSatisfied(curso,aprobadosSet){
    // Evalúa si se cumplen los prerrequisitos (soporta expresiones y/o y arrays legacy)
    if(curso.PrerrequisitosExpr)return evaluarExpr(curso.PrerrequisitosExpr,aprobadosSet);
    const arr=curso.Prerrequisitos||[];
    if(!arr.length)return true;
    return arr.every(elem=>_esExprCompleja(elem)?evaluarExpr(elem,aprobadosSet):aprobadosSet.has(elem));
}
function prereqLabel(curso){
    // Texto legible de los prerrequisitos para tooltip y modal
    if(curso.PrerrequisitosExpr)return curso.PrerrequisitosExpr;
    const arr=curso.Prerrequisitos||[];
    if(!arr.length)return'ninguno';
    return arr.join(', ');
}
function evaluarExpr(expr,aprobadosSet){
    // Evalúa "COM204 y (COM202 o COM217)"; devuelve true/false
    if(!expr)return true;
    if(Array.isArray(expr))return expr.every(c=>aprobadosSet.has(c));
    const tokens=(expr.match(/\(|\)|[A-Za-z][A-Za-z0-9_]*|\s+/g)||[]).filter(t=>t.trim());
    let pos=0;
    function peek(){return pos<tokens.length?tokens[pos]:null;}
    function eat(){return tokens[pos++];}
    function parseExpr(){
        let v=parseTerm();
        while(peek()&&peek().toLowerCase()==='y'){eat();v=parseTerm()&&v;}
        return v;
    }
    function parseTerm(){
        let v=parseFactor();
        while(peek()&&peek().toLowerCase()==='o'){eat();v=parseFactor()||v;}
        return v;
    }
    function parseFactor(){
        if(peek()==='('){eat();const v=parseExpr();if(peek()===')')eat();return v;}
        const t=eat();
        if(!t||t.toLowerCase()==='y'||t.toLowerCase()==='o')return true;
        return aprobadosSet.has(t.toUpperCase());
    }
    try{return parseExpr();}catch(_){return true;}
}

