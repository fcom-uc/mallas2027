            if(curso){const enBl=cardV.closest('#bl-'+t.id)!==null;cardV.parentNode.replaceChild(crearCard(curso,todos,t.id,enBl),cardV);}
        }
        recalcularTodo(t.id);
    });
    programarGuardado();
}

