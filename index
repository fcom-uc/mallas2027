function normalizarPrograma(p){
    const ck=Object.keys(p).find(k=>k.toLowerCase()==='creditosmaximos');
    const cv=ck?parseInt(p[ck],10):NaN;
    p.CreditosMaximos=(!isNaN(cv)&&cv>0)?cv:50;
    if(!p.SemestresMaximos||isNaN(parseInt(p.SemestresMaximos)))p.SemestresMaximos=9;
}

