/* ── Carpeta inicial del selector de archivos ──
   El navegador no permite fijar una ruta arbitraria: sólo acepta un handle ya
   autorizado por el usuario. Se usa la carpeta del archivo abierto y, si no hay
   ninguno, la última que el propio navegador recuerde para el id 'mallasfcom'. */
function opcionesPicker(base){
    const o=Object.assign({id:'mallasfcom'},base);
    if(fileHandle)o.startIn=fileHandle;
    return o;
}
/* Reintenta sin startIn si el handle guardado ya no es válido */
async function pickerConFallback(fn,base){
    try{ return await fn(opcionesPicker(base)); }
    catch(e){
        if(e&&(e.name==='AbortError'||e.name==='SecurityError'||e.name==='NotAllowedError'))throw e;
        console.warn('startIn descartado:',e);
        return await fn(Object.assign({id:'mallasfcom'},base));
    }
}

/* Persistencia del handle de carpeta (los handles no caben en localStorage) */
function _idb(){
    return new Promise((res,rej)=>{
        const r=indexedDB.open('mallasL',1);
        r.onupgradeneeded=()=>{r.result.createObjectStore('kv');};
        r.onsuccess=()=>res(r.result);
        r.onerror=()=>rej(r.error);
    });
}
async function idbSet(k,v){
    const d=await _idb();
    return new Promise((res,rej)=>{
        const t=d.transaction('kv','readwrite');
        t.objectStore('kv').put(v,k);
        t.oncomplete=()=>res();t.onerror=()=>rej(t.error);
    });
}
async function idbGet(k){
    const d=await _idb();
    return new Promise((res,rej)=>{
        const t=d.transaction('kv','readonly');
        const q=t.objectStore('kv').get(k);
        q.onsuccess=()=>res(q.result||null);q.onerror=()=>rej(q.error);
    });
}

