/* ================================================================
   EXPORTAR A EXCEL
   ================================================================ */
function exportarExcel(){cerrarMenus();document.getElementById('xls-overlay').classList.add('open');}
function cerrarXls(){document.getElementById('xls-overlay').classList.remove('open');}

function ejecutarExportXls(){
    const scope=document.getElementById('xls-scope').value;
    cerrarXls();

    if(scope==='visible'){
        const tab=tabs.find(t=>t.id===activeTabId);
        if(!tab){alert('No hay pestaña activa.');return;}
        const pk=tab.progKey;
        const cursos=cursosEnMalla(pk);
        if(cursos.length===0){alert('La malla visible no tiene cursos asignados a semestres.');return;}
        cursos.sort((a,b)=>(a.Semestre-b.Semestre)||((b.Capa||0)-(a.Capa||0)));
        const headers=['Código','Nombre','Créditos','Prerrequisitos','Etiqueta','Semestre'];
        const filas=[headers];
        cursos.forEach(c=>{
            const g=db.Cursos[c.Codigo]||{};
            const loc=db.Programas[pk].Cursos[c.Codigo]||{};
            filas.push([c.Codigo,g.Nombre||c.Nombre||'',(g.Creditos??c.Creditos??0),
                        (g.Prerrequisitos||[]).join(', '),loc.Etiqueta||c.Etiqueta||'',loc.Semestre??c.Semestre??'']);
        });
        function csvCellV(v){const s=String(v==null?'':v);return(s.includes(';')||s.includes('"')||s.includes('\n'))?'"'+s.replace(/"/g,'""')+'"':s;}
        const csv=filas.map(r=>r.map(csvCellV).join(';')).join('\r\n');
        const blob=new Blob(['\uFEFF'+csv],{type:'text/csv;charset=utf-8'});
        const url=URL.createObjectURL(blob);
        const a=document.createElement('a');a.href=url;a.download='malla_'+pk+'.csv';
        document.body.appendChild(a);a.click();
        setTimeout(()=>{URL.revokeObjectURL(url);a.remove();},500);
        return;
    }

    // Helper: códigos con etiqueta X en programa Y que tengan semestre asignado, ordenados
    function codsEt(progKey,etiqueta){
        return Object.entries(db.Programas[progKey].Cursos||{})
            .filter(([,l])=>l.Semestre&&(l.Etiqueta||'').toLowerCase()===etiqueta.toLowerCase())
            .map(([cod])=>cod).sort();
    }

    // Códigos con semestre asignado en alguna malla (excluye backlog)
    const usados=new Set();
    PROG_KEYS.forEach(pk=>{
        Object.entries(db.Programas[pk].Cursos||{}).forEach(([cod,loc])=>{
            if(loc.Semestre)usados.add(cod);
        });
    });

    // Determinar qué códigos exportar y en qué orden
    // Para 'all': todos los del catálogo (usados primero, luego sin usar)
    // Para 'used': solo los que tienen semestre en algún programa
    const todosCodigos=Object.keys(db.Cursos).sort();
    let codigos;
    if(scope==='used'){
        codigos=[...usados].sort();
    } else {
        // all: usados primero, luego sin usar
        const usadosOrden=[...usados].sort();
        const noUsados=todosCodigos.filter(c=>!usados.has(c));
        codigos=[...usadosOrden,...noUsados];
    }

    // Construir filas
    const headers=['Código','Nombre','Créditos','Prerrequisitos'];
    PROG_KEYS.forEach(pk=>{headers.push(pk+' Etiqueta');headers.push(pk+' Semestre');});
    const filas=[headers];
    codigos.forEach(cod=>{
        const g=db.Cursos[cod]||{};
        const prereqs=(g.Prerrequisitos||[]).join(', ');
        const fila=[cod, g.Nombre||'', g.Creditos||0, prereqs];
        PROG_KEYS.forEach(pk=>{
            const loc=db.Programas[pk].Cursos?.[cod];
            fila.push(loc?loc.Etiqueta||'':'');
            fila.push(loc&&loc.Semestre?loc.Semestre:'');
        });
        filas.push(fila);
    });

    // Generar CSV con separador ; (compatible con Excel en español/regional)
    function csvCell(v){
        const s=String(v==null?'':v);
        return (s.includes(';')||s.includes('"')||s.includes('\n'))
            ? '"'+s.replace(/"/g,'""')+'"' : s;
    }
    const csv=filas.map(row=>row.map(csvCell).join(';')).join('\r\n');

    const bom='\uFEFF'; // BOM para que Excel reconozca UTF-8
    const blob=new Blob([bom+csv],{type:'text/csv;charset=utf-8'});
    const url=URL.createObjectURL(blob);
    const a=document.createElement('a');
    a.href=url;
    a.download='mallas_cursos.csv';
    document.body.appendChild(a);
    a.click();
    setTimeout(()=>{URL.revokeObjectURL(url);a.remove();},500);
}

