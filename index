    const nuevaEt=document.getElementById('m-etiqueta').value;
    const prereqStr=document.getElementById('m-prereqs').value.trim();
    const _tieneLogica=/\bo\b|\(/i.test(prereqStr);
    const nuevosPrereqs=_tieneLogica?prereqCodigos(prereqStr):prereqStr?prereqStr.split(/[,\sy]+/).map(s=>s.trim().toUpperCase()).filter(c=>/^[A-Z]/.test(c)):[];
    const nuevoComent=document.getElementById('m-comentarios').value;
    if(!nuevoCod){alert('El código no puede estar vacío.');return;}
    if(!nuevoNom){alert('El nombre no puede estar vacío.');return;}
    if(isNaN(nuevoCred)||nuevoCred<0){alert('Los créditos deben ser positivos.');return;}
    if(nuevoCod!==_modalCodigo){
        if(db.Cursos[nuevoCod]){alert('Ya existe un curso con el código "'+nuevoCod+'".');return;}
        db.Cursos[nuevoCod]=db.Cursos[_modalCodigo];delete db.Cursos[_modalCodigo];
        PROG_KEYS.forEach(pk=>{
            const pc=db.Programas[pk].Cursos;
            if(pc[_modalCodigo]){pc[nuevoCod]=pc[_modalCodigo];delete pc[_modalCodigo];}
        });
        Object.values(db.Cursos).forEach(c=>{
            if(Array.isArray(c.Prerrequisitos))c.Prerrequisitos=c.Prerrequisitos.map(r=>r===_modalCodigo?nuevoCod:r);
            if(c.PrerrequisitosExpr)c.PrerrequisitosExpr=c.PrerrequisitosExpr.replace(new RegExp('\\b'+_modalCodigo+'\\b','g'),nuevoCod);
        });
    }
    db.Cursos[nuevoCod].Nombre=nuevoNom;db.Cursos[nuevoCod].Creditos=nuevoCred;
    db.Cursos[nuevoCod].Prerrequisitos=nuevosPrereqs;
    if(_tieneLogica)db.Cursos[nuevoCod].PrerrequisitosExpr=prereqStr;
    else delete db.Cursos[nuevoCod].PrerrequisitosExpr;
    db.Cursos[nuevoCod].Comentarios=nuevoComent;
    if(!db.Programas[tab.progKey].Cursos[nuevoCod])db.Programas[tab.progKey].Cursos[nuevoCod]={};
    db.Programas[tab.progKey].Cursos[nuevoCod].Etiqueta=nuevaEt;
    const codOrig=_modalCodigo;cerrarModal();
    tabs.forEach(t=>{
        const cardV=document.querySelector('#panel-'+t.id+' [data-codigo="'+CSS.escape(codOrig)+'"], #panel-'+t.id+' [data-codigo="'+CSS.escape(nuevoCod)+'"]');
