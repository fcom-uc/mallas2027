    vistaModo=modo;
    impactoActivo=(modo==='impacto');
    if(modo!=='impacto')limpiarResaltado();
    document.querySelectorAll('.vista-seg-btn').forEach(b=>b.classList.toggle('active',b.dataset.modo===modo));
    tabs.forEach(t=>{if(db)buildWorkspace(t.id);});
}
function calcularImpactos(lista){
    const imp={};lista.forEach(c=>{imp[c.Codigo]=new Set();});
    function marca(cod,dep){(lista.find(c=>c.Codigo===cod)?.Prerrequisitos||[]).forEach(req=>{if(imp[req]&&!imp[req].has(dep)){imp[req].add(dep);marca(req,dep);}});}
    lista.forEach(c=>marca(c.Codigo,c.Codigo));return imp;
}
function nivelImpacto(n){return n===0?0:n<=2?1:n<=5?2:n<=10?3:4;}
function aplicarImpacto(tabId){
    const tab=tabs.find(t=>t.id===tabId);
    const cards=document.querySelectorAll('#panel-'+tabId+' .curso-card');
    cards.forEach(c=>c.classList.remove('impact-0','impact-1','impact-2','impact-3','impact-4'));
    if(!impactoActivo)return;
    const impactos=calcularImpactos(cursosEnMalla(tab.progKey));
    cards.forEach(card=>card.classList.add('impact-'+nivelImpacto(impactos[card.getAttribute('data-codigo')]?.size||0)));
}

/* ================================================================
   VISTA GRAFO (solo lectura): capas por camino más largo,
   ruta crítica y cuellos de botella
   ================================================================ */
function estiloEtiqueta(et){
    const k=(et||'').toLowerCase();
    const known=['pc','fg','major','minor','opr','obligatorio','salida'];
    const key=known.includes(k)?k:'default';
    return etiquetaStyles[key]||{bg:'#7f8c8d',fg:'#ffffff'};
}

function buildGrafo(tabId){
    const tab=tabs.find(t=>t.id===tabId);
    const cont=document.getElementById('ws-'+tabId);
    const cursos=cursosEnMalla(tab.progKey);
    if(cursos.length===0){
        cont.innerHTML='<div class="grafo-empty">No hay cursos colocados en la malla de este programa.</div>';
        return;
    }
    const enMalla=new Set(cursos.map(c=>c.Codigo));
    const byCod={};cursos.forEach(c=>byCod[c.Codigo]=c);
    const preq=c=>(c.Prerrequisitos||[]).filter(r=>enMalla.has(r));

    // 1. Capa = camino más largo de prerrequisitos (con guardia de ciclos)
    const capa={},estado={};
    function calcCapa(cod){
        if(capa[cod]!==undefined)return capa[cod];
        if(estado[cod]==='visit')return 0;            // arista hacia atrás (ciclo)
        estado[cod]='visit';
        let m=0;
        preq(byCod[cod]).forEach(r=>{m=Math.max(m,calcCapa(r)+1);});
        estado[cod]='done';capa[cod]=m;return m;
    }
    cursos.forEach(c=>calcCapa(c.Codigo));
    const maxCapa=Math.max(...cursos.map(c=>capa[c.Codigo]));

    // 2. Agrupar y ordenar por capa (baricentro de prereqs, una pasada)
    const porCapa=[];for(let i=0;i<=maxCapa;i++)porCapa[i]=[];
    cursos.forEach(c=>porCapa[capa[c.Codigo]].push(c.Codigo));
    const pos={};
    porCapa[0].sort((a,b)=>(byCod[a].Etiqueta||'').localeCompare(byCod[b].Etiqueta||'')||a.localeCompare(b));
    porCapa[0].forEach((cod,i)=>pos[cod]=i);
    for(let l=1;l<=maxCapa;l++){
        porCapa[l].sort((a,b)=>{
            const pa=preq(byCod[a]).map(r=>pos[r]).filter(v=>v!==undefined);
            const pb=preq(byCod[b]).map(r=>pos[r]).filter(v=>v!==undefined);
            const ma=pa.length?pa.reduce((s,v)=>s+v,0)/pa.length:1e9;
            const mb=pb.length?pb.reduce((s,v)=>s+v,0)/pb.length:1e9;
            return ma-mb||a.localeCompare(b);
        });
        porCapa[l].forEach((cod,i)=>pos[cod]=i);
    }

    // 3. Cuellos de botella: nº de cursos que dependen (transitivo)
    const impactos=calcularImpactos(cursos);
    const impCount={};cursos.forEach(c=>impCount[c.Codigo]=impactos[c.Codigo]?.size||0);
    let maxImpCod=null,maxImp=-1;
    cursos.forEach(c=>{if(impCount[c.Codigo]>maxImp){maxImp=impCount[c.Codigo];maxImpCod=c.Codigo;}});

    // 4. Ruta crítica: cadena más larga (desempate por impacto)
    let endNode=null,best=-1;
    cursos.forEach(c=>{const k=capa[c.Codigo]*1000+impCount[c.Codigo];if(k>best){best=k;endNode=c.Codigo;}});
    const critEdges=new Set();const cadena=[];
    let cur=endNode;
    while(cur!=null){
        cadena.push(cur);
        const ps=preq(byCod[cur]).filter(r=>capa[r]===capa[cur]-1).sort((a,b)=>impCount[b]-impCount[a]);
        if(ps.length===0)break;
        critEdges.add(ps[0]+'>'+cur);cur=ps[0];
    }
    cadena.reverse();
    const critNodes=new Set(cadena);

    // 5. Geometría
    const NW=152,NH=56,HGAP=72,VGAP=22,PAD=20;
    const colX=l=>PAD+l*(NW+HGAP);
    const rowY=p=>PAD+p*(NH+VGAP);
    const maxRows=Math.max(...porCapa.map(c=>c.length));
    const W=colX(maxCapa)+NW+PAD;
    const H=rowY(maxRows-1)+NH+PAD;

    const trunc=(s,n)=>{s=s||'';return s.length>n?s.slice(0,n-1)+'…':s;};
    const nivColor=['#95a5a6','#f1c40f','#e67e22','#e74c3c','#7b241c'];

    // 6. Aristas (prereq → curso)
    let edgesNorm='',edgesCrit='';
    cursos.forEach(c=>{
        preq(c).forEach(r=>{
            const x1=colX(capa[r])+NW, y1=rowY(pos[r])+NH/2;
            const x2=colX(capa[c.Codigo]), y2=rowY(pos[c.Codigo])+NH/2;
            const dx=Math.max(28,(x2-x1)/2);
            const d='M '+x1+' '+y1+' C '+(x1+dx)+' '+y1+', '+(x2-dx)+' '+y2+', '+x2+' '+y2;
            if(critEdges.has(r+'>'+c.Codigo))
                edgesCrit+='<path id="ge-'+tabId+'-'+r+'-'+c.Codigo+'" d="'+d+'" fill="none" stroke="#e74c3c" stroke-width="3" marker-end="url(#arrowCrit)"/>';
            else
                edgesNorm+='<path id="ge-'+tabId+'-'+r+'-'+c.Codigo+'" d="'+d+'" fill="none" stroke="#c7ccd1" stroke-width="1.5" marker-end="url(#arrow)"/>';
        });
    });

    // 7. Nodos
    let nodos='';
    cursos.forEach(c=>{
        const x=colX(capa[c.Codigo]), y=rowY(pos[c.Codigo]);
        const st=estiloEtiqueta(c.Etiqueta);
        const esCrit=critNodes.has(c.Codigo);
        const n=impCount[c.Codigo];
        const deps=cursos.filter(o=>o.Prerrequisitos?.includes(c.Codigo)).map(o=>o.Codigo);
        const tip=c.Codigo+' — '+(c.Nombre||'')+
                  '\nEtiqueta: '+(c.Etiqueta||'')+'  ·  Semestre '+c.Semestre+'  ·  '+(c.Creditos||0)+' cr.'+
                  '\nRequisitos: '+(preq(c).length?preq(c).join(', '):'ninguno')+
                  '\nEs requisito de: '+(deps.length?deps.join(', '):'ninguno')+
                  '\nDependen de él (total): '+n+(esCrit?'\n★ En la ruta crítica':'');
        nodos+='<g class="grafo-node" id="gn-'+tabId+'-'+c.Codigo+
               '" ondblclick="resaltarRutaGrafo(&#39;'+tabId+'&#39;,&#39;'+c.Codigo+'&#39;);event.stopPropagation()"'+
               ' onclick="event.stopPropagation()" style="cursor:pointer"><title>'+esc(tip)+'</title>'+
            '<rect x="'+x+'" y="'+y+'" width="'+NW+'" height="'+NH+'" rx="7" '+
              'fill="'+st.bg+'" stroke="'+(esCrit?'#c0392b':'rgba(0,0,0,0.18)')+'" stroke-width="'+(esCrit?3:1)+'"/>'+
            '<text x="'+(x+9)+'" y="'+(y+18)+'" font-size="11" font-weight="700" fill="'+st.fg+'">'+esc(c.Codigo)+' ['+esc(c.Etiqueta)+']</text>'+
            '<text x="'+(x+9)+'" y="'+(y+34)+'" font-size="9.5" fill="'+st.fg+'">'+esc(trunc(c.Nombre,24))+'</text>'+
            '<text x="'+(x+9)+'" y="'+(y+48)+'" font-size="8.5" fill="'+st.fg+'" opacity="0.85">Sem '+c.Semestre+'  ·  '+(c.Creditos||0)+' cr.</text>';
        if(n>0){
            const bc=nivColor[nivelImpacto(n)];
            const bx=x+NW-13, by=y+13, w=String(n).length>1?8+String(n).length*5:18;
            nodos+='<rect x="'+(bx-w/2)+'" y="'+(by-9)+'" width="'+w+'" height="18" rx="9" fill="'+bc+'"/>'+
                   '<text x="'+bx+'" y="'+(by+4)+'" font-size="10" font-weight="800" fill="#fff" text-anchor="middle">'+n+'</text>';
        }
        nodos+='</g>';
    });

    const svg='<svg width="'+W+'" height="'+H+'" viewBox="0 0 '+W+' '+H+'" xmlns="http://www.w3.org/2000/svg"'+
             ' onclick="limpiarRutaGrafo(&#39;'+tabId+'&#39;)" style="cursor:default">'+
        '<defs>'+
          '<marker id="arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">'+
            '<path d="M0,0 L8,4 L0,8 Z" fill="#c7ccd1"/></marker>'+
          '<marker id="arrowCrit" markerWidth="9" markerHeight="9" refX="7" refY="4.5" orient="auto">'+
            '<path d="M0,0 L9,4.5 L0,9 Z" fill="#e74c3c"/></marker>'+
        '</defs>'+
        edgesNorm+edgesCrit+nodos+
        '</svg>';

    const resumenCadena=cadena.length<=2?cadena.join(' → ')
        :(cadena[0]+' → … → '+cadena[cadena.length-1]);
    const legend=
        '<div class="grafo-legend">'+
          '<span><b>Ruta crítica:</b> '+cadena.length+' curso'+(cadena.length===1?'':'s')+
            (cadena.length?' ('+esc(resumenCadena)+')':'')+'</span>'+
          (maxImpCod&&maxImp>0?'<span><b>Mayor cuello de botella:</b> '+esc(maxImpCod)+' — '+maxImp+' cursos dependen de él</span>':'')+
          '<span class="lg-chip"><span class="lg-line"></span> ruta crítica</span>'+
          '<span class="lg-chip"><span class="lg-bubble">N</span> cursos que dependen de él</span>'+
          '<span style="font-size:0.78em;color:#95a5a6">Doble clic en un curso para ver su cadena de requisitos · Clic en el fondo para limpiar</span>'+
        '</div>';
    _grafoDatos[tabId]=cursos;
    cont.innerHTML=legend+'<div class="grafo-scroll">'+svg+'</div>';
}

const _grafoDatos={};
const _grafoHighlight={};

function resaltarRutaGrafo(tabId, cod){
    if(_grafoHighlight[tabId]===cod){limpiarRutaGrafo(tabId);return;}
    _grafoHighlight[tabId]=cod;
    const cursos=_grafoDatos[tabId];
    if(!cursos)return;
    const enMalla=new Set(cursos.map(c=>c.Codigo));
    const byCod={};cursos.forEach(c=>byCod[c.Codigo]=c);
    const preq=c=>(c.Prerrequisitos||[]).filter(r=>enMalla.has(r));
    const anc=new Set([cod]);
    const queue=[cod];
    while(queue.length){
        const cur=queue.pop();
        preq(byCod[cur]).forEach(r=>{if(!anc.has(r)){anc.add(r);queue.push(r);}});
    }
    cursos.forEach(c=>{
        const el=document.getElementById('gn-'+tabId+'-'+c.Codigo);
        if(el)el.style.opacity=anc.has(c.Codigo)?'1':'0.12';
    });
    cursos.forEach(c=>{
        preq(c).forEach(r=>{
            const el=document.getElementById('ge-'+tabId+'-'+r+'-'+c.Codigo);
            if(el)el.style.opacity=(anc.has(r)&&anc.has(c.Codigo))?'1':'0.05';
        });
    });
}

function limpiarRutaGrafo(tabId){
    tabId=parseInt(tabId,10);
    _grafoHighlight[tabId]=null;
    const cursos=_grafoDatos[tabId];
    if(!cursos)return;
    const enMalla=new Set(cursos.map(c=>c.Codigo));
    const byCod={};cursos.forEach(c=>byCod[c.Codigo]=c);
    const preq=c=>(c.Prerrequisitos||[]).filter(r=>enMalla.has(r));
    cursos.forEach(c=>{
        const el=document.getElementById('gn-'+tabId+'-'+c.Codigo);
        if(el)el.style.opacity='1';
    });
    cursos.forEach(c=>{
        preq(c).forEach(r=>{
            const el=document.getElementById('ge-'+tabId+'-'+r+'-'+c.Codigo);
            if(el)el.style.opacity='1';
        });
    });
}

/* ================================================================
   VISTA GANTT: earliest/latest start por CPM, holgura, ruta crítica
   ================================================================ */
function buildGantt(tabId){
    const tab=tabs.find(t=>t.id===tabId);
    const cont=document.getElementById('ws-'+tabId);
    const cursos=cursosEnMalla(tab.progKey);
    if(cursos.length===0){
        cont.innerHTML='<div class="grafo-empty">No hay cursos colocados en la malla de este programa.</div>';
        return;
    }
    const prog=db.Programas[tab.progKey];
    const totalSem=prog.SemestresMaximos||10;
    const enMalla=new Set(cursos.map(c=>c.Codigo));
    const byCod={};cursos.forEach(c=>byCod[c.Codigo]=c);
    const preq=c=>(c.Prerrequisitos||[]).filter(r=>enMalla.has(r));
    const deps={};cursos.forEach(c=>deps[c.Codigo]=[]);
    cursos.forEach(c=>preq(c).forEach(r=>deps[r].push(c.Codigo)));

    // Pasada adelante: ES = semestre más temprano posible (1-based)
    const es={},estF={};
    function calcES(cod){
        if(es[cod]!==undefined)return es[cod];
        if(estF[cod]==='visit')return 1;
        estF[cod]='visit';
        let m=0;preq(byCod[cod]).forEach(r=>{m=Math.max(m,calcES(r));});
        estF[cod]='done';es[cod]=m+1;return es[cod];
    }
    cursos.forEach(c=>calcES(c.Codigo));

    // Pasada atrás: LS = semestre más tardío tolerable
    // Deadline = profundidad máxima teórica (no SemestresMaximos)
    // para que la ruta crítica tenga holgura 0
    const maxES=Math.max(...Object.values(es));
    const ls={},estB={};
    function calcLS(cod){
        if(ls[cod]!==undefined)return ls[cod];
        if(estB[cod]==='visit')return maxES;
        estB[cod]='visit';
        const dd=deps[cod];
        let m=maxES+1;dd.forEach(d=>{m=Math.min(m,calcLS(d));});
        estB[cod]='done';
        ls[cod]=Math.max(es[cod],m-1);
        return ls[cod];
    }
    cursos.forEach(c=>calcLS(c.Codigo));

    // Holgura y ruta crítica
    const slack={};cursos.forEach(c=>slack[c.Codigo]=Math.max(0,ls[c.Codigo]-es[c.Codigo]));
    const critCount=cursos.filter(c=>slack[c.Codigo]===0).length;

    // Ordenar: por ES, luego semestre real, luego código
    const sorted=[...cursos].sort((a,b)=>
        es[a.Codigo]-es[b.Codigo]||a.Semestre-b.Semestre||a.Codigo.localeCompare(b.Codigo));

    // Geometría
    const LW=188,CW=66,RH=38,HH=30,PAD=0;
    const W=LW+CW*totalSem;
    const H=HH+RH*sorted.length+1;
    const cx=s=>LW+(s-1)*CW;
    const ry=i=>HH+i*RH;
    const trunc=(s,n)=>{s=s||'';return s.length>n?s.slice(0,n-1)+'…':s;};

    let svg='<svg width="'+W+'" height="'+H+'" viewBox="0 0 '+W+' '+H+'"'+
            ' xmlns="http://www.w3.org/2000/svg" style="display:block">';

    // Columnas de semestres (fondo alterno) + encabezados
    for(let s=1;s<=totalSem;s++){
        const x=cx(s);
        svg+='<rect x="'+x+'" y="0" width="'+CW+'" height="'+H+'" fill="'+(s%2?'#f7f9fb':'#eef2f7')+'"/>';
        svg+='<line x1="'+x+'" y1="0" x2="'+x+'" y2="'+H+'" stroke="#dde3ea" stroke-width="0.5"/>';
        svg+='<text x="'+(x+CW/2)+'" y="'+(HH-9)+'" text-anchor="middle" font-size="11"'+
             ' font-weight="600" fill="#7f8c8d">S'+s+'</text>';
    }
    // Área de etiquetas (encima de columnas)
    svg+='<rect x="0" y="0" width="'+LW+'" height="'+H+'" fill="#fff"/>';
    svg+='<line x1="'+LW+'" y1="0" x2="'+LW+'" y2="'+H+'" stroke="#c8d0da" stroke-width="1"/>';
    svg+='<line x1="0" y1="'+HH+'" x2="'+W+'" y2="'+HH+'" stroke="#c8d0da" stroke-width="1"/>';
    svg+='<text x="'+(LW/2)+'" y="'+(HH-9)+'" text-anchor="middle" font-size="11"'+
         ' font-weight="600" fill="#7f8c8d">Curso</text>';

    // Filas
    sorted.forEach((c,i)=>{
        const y=ry(i);
        const slk=slack[c.Codigo];
        const crit=(slk===0);
        const st=estiloEtiqueta(c.Etiqueta);
        const sem=c.Semestre;
        const esV=es[c.Codigo],lsV=ls[c.Codigo];

        // Separador de fila
        svg+='<line x1="0" y1="'+(y+RH)+'" x2="'+W+'" y2="'+(y+RH)+'"'+
             ' stroke="#e5eaf0" stroke-width="0.5"/>';

        // Etiqueta del curso
        svg+='<text x="8" y="'+(y+RH/2-4)+'" font-size="10" font-weight="700" fill="#2c3e50">'+
             esc(c.Codigo)+'</text>';
        svg+='<text x="8" y="'+(y+RH/2+9)+'" font-size="9" fill="#95a5a6">'+
             esc(trunc(c.Nombre,27))+'</text>';

        // Barra de rango posible [ES..LS]
        if(lsV>esV){
            const rx=cx(esV)+4,rw=(lsV-esV+1)*CW-8;
            const by=y+RH/2-7,bh=14;
            svg+='<rect x="'+rx+'" y="'+by+'" width="'+rw+'" height="'+bh+'" rx="3"'+
                 ' fill="'+(crit?'rgba(231,76,60,0.1)':'#dde3ea')+'"/>';
            svg+='<text x="'+(rx+rw-3)+'" y="'+(by+bh-2)+'" text-anchor="end"'+
                 ' font-size="8" fill="#aab4be">+'+slk+'</text>';
        }

        // Barra de posición real
        const bx=cx(sem)+4,bw=CW-8,by=y+5,bh=RH-10;
        const fueraRango=(sem>lsV||sem<esV);
        svg+='<rect x="'+bx+'" y="'+by+'" width="'+bw+'" height="'+bh+'" rx="5"'+
             ' fill="'+st.bg+'" opacity="'+(fueraRango?'0.55':'1')+'"'+
             (crit?' stroke="#c0392b" stroke-width="2.5"':'')+'/>';
        svg+='<text x="'+(bx+bw/2)+'" y="'+(by+bh/2+4)+'" text-anchor="middle"'+
             ' font-size="9" font-weight="700" fill="'+st.fg+'">'+
             esc(c.Codigo)+'</text>';
    });

    svg+='</svg>';

    const legend=
        '<div class="grafo-legend">'+
          '<span><b>Duración mínima teórica:</b> '+maxES+' semestres  ·  <b>Ruta crítica:</b> '+critCount+' curso'+(critCount===1?'':'s')+' (holgura 0)</span>'+
          '<span class="lg-chip">'+
            '<span style="display:inline-block;width:28px;height:11px;background:#dde3ea;border-radius:2px;vertical-align:middle;"></span>'+
            ' ventana óptima (ES → LS)</span>'+
          '<span class="lg-chip">'+
            '<span style="display:inline-block;width:14px;height:14px;background:#e74c3c;border-radius:3px;border:2px solid #c0392b;vertical-align:middle;"></span>'+
            ' ruta crítica</span>'+
          '<span style="font-size:0.78em;color:#95a5a6">+N = semestres de holgura  ·  barra tenue = colocado fuera de la ventana óptima</span>'+
        '</div>';
    cont.innerHTML=legend+'<div class="grafo-scroll">'+svg+'</div>';
}

let _resaltadoTabId=null,_resaltadoCodigo=null;
function resaltarArbol(codigo){
    const tab=tabs.find(t=>t.id===activeTabId);if(!tab)return;
    if(_resaltadoCodigo===codigo&&_resaltadoTabId===activeTabId){limpiarResaltado();return;}
    limpiarResaltado();_resaltadoTabId=activeTabId;_resaltadoCodigo=codigo;
    const lista=cursosDelPrograma(tab.progKey);
    function getAnc(cod,v){if(v.has(cod))return;v.add(cod);(lista.find(c=>c.Codigo===cod)?.Prerrequisitos||[]).forEach(r=>getAnc(r,v));}
    function getDes(cod,v){if(v.has(cod))return;v.add(cod);lista.forEach(c=>{if(c.Prerrequisitos?.includes(cod))getDes(c.Codigo,v);});}
    const anc=new Set(),des=new Set();
    (lista.find(c=>c.Codigo===codigo)?.Prerrequisitos||[]).forEach(r=>getAnc(r,anc));
    getDes(codigo,des);des.delete(codigo);
    document.querySelectorAll('#panel-'+activeTabId+' .curso-card').forEach(card=>{
        const cod=card.getAttribute('data-codigo');
        card.classList.remove('hl-self','hl-prereq','hl-dependent','hl-dim');
        if(cod===codigo)card.classList.add('hl-self');
        else if(anc.has(cod))card.classList.add('hl-prereq');
        else if(des.has(cod))card.classList.add('hl-dependent');
        else card.classList.add('hl-dim');
    });
}
function limpiarResaltado(){
    if(!_resaltadoTabId)return;
    document.querySelectorAll('#panel-'+_resaltadoTabId+' .curso-card').forEach(c=>c.classList.remove('hl-self','hl-prereq','hl-dependent','hl-dim'));
    _resaltadoTabId=null;_resaltadoCodigo=null;
}

