<!-- PANTALLA DE BIENVENIDA (sin archivo abierto) -->
<div class="modal-overlay" id="welcome-overlay">
    <div class="modal-box narrow" style="gap:14px;">
        <div style="text-align:center;font-size:2em;line-height:1;">📋</div>
        <h3 style="border:none;padding:0;text-align:center;">Mallas FCOM</h3>
        <p style="margin:0;font-size:0.85em;color:#777;text-align:center;line-height:1.45;">
            Cargando <strong>MallasFCOM.json</strong>…
        </p>
        <p style="margin:0;font-size:0.75em;color:#999;text-align:center;line-height:1.4;" id="wc-fallback" style="display:none">
            Si no carga automáticamente, selecciona el archivo manualmente:
        </p>
        <button class="wc-btn primary" id="wc-btn-abrir" onclick="abrirArchivo()" style="display:none"><span>📂</span>Seleccionar MallasFCOM.json…</button>
    </div>
</div>

<!-- MODAL EDICIÓN DE CURSO -->
<div class="modal-overlay" id="modal-overlay" onclick="cerrarModalSiOverlay(event)">
    <div class="modal-box">
        <h3 id="modal-titulo">Información del curso</h3>
        <p class="modal-section-label">Datos globales del curso</p>
        <div class="modal-field"><label>Código</label><input type="text" id="m-codigo"></div>
        <div class="modal-field">
            <label>Nombre</label><input type="text" id="m-nombre">
            
        </div>
        <div class="modal-field">
            <label>Créditos</label><input type="number" id="m-creditos" min="0">
            
        </div>
        <div class="modal-field">
            <label>Prerrequisitos</label>
            <input type="text" id="m-prereqs" placeholder="COM140, COM141 o COM140 y (COM141 o COM142)">
                        
        </div>
