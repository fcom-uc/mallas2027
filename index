async function guardar(auto){
    cerrarMenus();
    if(!db)return;
    if(!fileHandle){if(auto)return;return guardarComo();}
    try{
        setFbStatus('saving','Guardando…');
        const texto=serializar();
        const w=await fileHandle.createWritable();
        await w.write(texto);
        await w.close();
        dirty=false;respaldoLocal();estadoArchivo();
    }catch(e){
        console.error(e);
        setFbStatus('error','Error al guardar');
        if(!auto)alert('No se pudo guardar en el archivo: '+e.message+'\n\nUsa "Guardar como…" para elegir otra ubicación.');
    }
}

async function guardarComo(){
    cerrarMenus();
    if(!db)return;
    const texto=serializar();
    const sugerido=fileName||CONFIG.nombreArchivoPorDefecto;
    if(FS_OK){
        try{
            const h=await pickerConFallback(window.showSaveFilePicker.bind(window),{
                suggestedName:sugerido,
                types:[{description:'Archivo JSON',accept:{'application/json':['.json']}}]
            });
            const w=await h.createWritable();
            await w.write(texto);
            await w.close();
            fileHandle=h;fileName=h.name;dirty=false;respaldoLocal();estadoArchivo();
            return;
        }catch(e){
            if(e&&e.name==='AbortError')return;
            console.warn('showSaveFilePicker no disponible:',e);
        }
    }
    descargarTexto(texto,sugerido);
    dirty=false;estadoArchivo();
}

function descargarTexto(texto,nombre){
    const blob=new Blob([texto],{type:'application/json;charset=utf-8'});
    const url=URL.createObjectURL(blob);
    const a=document.createElement('a');a.href=url;a.download=nombre;
    document.body.appendChild(a);a.click();a.remove();
    setTimeout(()=>URL.revokeObjectURL(url),1500);
}

function confirmarDescartar(){
    if(!db||!dirty)return true;
    return confirm('Hay cambios sin guardar en "'+(fileName||'Sin título')+'".\n\n¿Descartarlos y continuar?');
}

async function abrirArchivo(){
    cerrarMenus();
    if(!confirmarDescartar())return;
    if(FS_OK&&typeof window.showOpenFilePicker==='function'){
        try{
            const [h]=await pickerConFallback(window.showOpenFilePicker.bind(window),{
                multiple:false,
                types:[{description:'Archivo JSON',accept:{'application/json':['.json']}}]
            });
            const f=await h.getFile();
            const txt=await f.text();
            if(cargarDesdeTexto(txt,f.name))fileHandle=h;
            return;
        }catch(e){
            if(e&&e.name==='AbortError')return;
            console.warn('showOpenFilePicker no disponible:',e);
        }
    }
    const inp=document.createElement('input');
    inp.type='file';inp.accept='.json,application/json';
    inp.onchange=function(){
        const f=inp.files&&inp.files[0];if(!f)return;
        const r=new FileReader();
        r.onload=function(){if(cargarDesdeTexto(String(r.result),f.name))fileHandle=null;};
        r.readAsText(f,'UTF-8');
    };
    inp.click();
}

function cargarDesdeTexto(texto,nombre){
    try{
        const json=JSON.parse(String(texto).replace(/^\uFEFF/,''));
        if(!json.Cursos||!json.Programas){alert('El archivo no tiene el formato esperado (faltan "Cursos" o "Programas").');return false;}
        aplicarDb(json,nombre);
        return true;
    }catch(e){alert('Error al leer el archivo: '+e.message);return false;}
}

/* Instala un objeto de datos y reconstruye toda la interfaz */
function aplicarDb(json,nombre){
    tabs.forEach(t=>{(t.sortables||[]).forEach(sx=>{try{sx.destroy();}catch(_){}});});
    db=json;
    if(!db.Cursos)db.Cursos={};
    if(!db.Programas)db.Programas={};
    if(!db.Config)db.Config={};
    delete db.Config.Password;               // la versión local no usa contraseña
    if(!db.Config.RutaProgramas)db.Config.RutaProgramas=RUTA_PROGRAMAS_DEF;
    if(Object.keys(db.Programas).length===0)
        db.Programas['PROG1']={Nombre:'Programa 1',SemestresMaximos:9,CreditosMaximos:50,Cursos:{}};
    PROG_KEYS=Object.keys(db.Programas);
    PROG_KEYS.forEach(k=>{
        if(!db.Programas[k].Cursos)db.Programas[k].Cursos={};
        normalizarPrograma(db.Programas[k]);
    });
    etiquetaStyles=JSON.parse(JSON.stringify(DEFAULT_STYLES));
    if(db.Config.EtiquetaStyles)Object.assign(etiquetaStyles,db.Config.EtiquetaStyles);
    etiquetaOrder=db.Config.EtiquetaOrder||Object.keys(etiquetaStyles).filter(k=>k!=='default');
    aplicarCSSVariables();
    fileName=nombre||null;
    dirty=false;
    cerrarWelcome();
    nextTabId=1;
    inicializarTabs();
    estadoArchivo();
    respaldoLocal();
}

