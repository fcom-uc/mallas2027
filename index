function agregarPrograma(){
    cerrarMenus();
    let clave=prompt('Clave del nuevo programa (ej: PUB2):');
    if(!clave)return;
    clave=clave.trim().toUpperCase();
    if(!clave){alert('La clave no puede estar vacía.');return;}
    if(db.Programas[clave]){alert('Ya existe un programa con la clave "'+clave+'".');return;}
    const nombre=prompt('Nombre del programa:',clave);
    if(nombre===null)return;
    db.Programas[clave]={Nombre:nombre.trim()||clave,SemestresMaximos:9,CreditosMaximos:50,Cursos:{}};
    PROG_KEYS=Object.keys(db.Programas);
    inicializarTabs();
    // Activar la pestaña del nuevo programa
    const t=tabs.find(t=>t.progKey===clave);
    if(t){activeTabId=t.id;renderTabStrip();tabs.forEach(tt=>buildWorkspace(tt.id));}
    programarGuardado();
}
function quitarPrograma(){
    cerrarMenus();
    const tab=tabs.find(t=>t.id===activeTabId);
    if(!tab)return;
    const pk=tab.progKey;
    const nombre=db.Programas[pk]?.Nombre||pk;
    if(PROG_KEYS.length<=1){alert('No se puede eliminar el único programa existente.');return;}
    if(!confirm('¿Quitar el programa "'+nombre+'" ('+pk+')?\nSe eliminarán sus asignaciones de semestre y etiqueta, pero los cursos permanecerán en el catálogo.'))return;
    delete db.Programas[pk];
    PROG_KEYS=Object.keys(db.Programas);
    inicializarTabs();
    programarGuardado();
}
function agregarPestana(){
    if(tabs.length>=6){alert('Ya hay 6 pestañas abiertas.');return;}
    const id=nextTabId++;
    const visibles=new Set(tabs.map(t=>t.progKey));
    const pk=PROG_KEYS.find(k=>!visibles.has(k))||PROG_KEYS[0];
    tabs.push({id,progKey:pk,backlogVisible:true,sortables:[]});
    const panel=document.createElement('div');
    panel.className='tab-panel';
    panel.id='panel-'+id;
    document.getElementById('tab-content-wrapper').appendChild(panel);
    activeTabId=id;
    document.querySelectorAll('.tab-panel').forEach(p=>p.classList.remove('active'));
    panel.classList.add('active');
    renderTabStrip();
    buildWorkspace(id);
    abrirProgPicker(id);
}
function abrirProgPicker(tabId){
    const overlay=document.getElementById('prog-picker-overlay');
    const list=document.getElementById('prog-picker-list');
    const tab=tabs.find(t=>t.id===tabId);
    list.innerHTML='';
    PROG_KEYS.forEach(pk=>{
        const nombre=db.Programas[pk]?.Nombre||pk;
        const activo=tab&&tab.progKey===pk;
        const btn=document.createElement('button');
        btn.style.cssText='padding:10px 14px;border:none;border-radius:6px;cursor:pointer;text-align:left;font-size:0.9em;font-family:inherit;width:100%;'+(activo?'background:#3498db;color:#fff;':'background:#f0f4f8;color:#2c3e50;');
        btn.innerHTML='<strong>'+esc(pk)+'</strong> — '+esc(nombre);
        btn.addEventListener('click',function(){cambiarProgPestana(tabId,pk);});
        list.appendChild(btn);
    });
    overlay.classList.add('open');
}
function cerrarProgPicker(){document.getElementById('prog-picker-overlay').classList.remove('open');}
function cambiarProgPestana(tabId,nuevoPk){
    cerrarProgPicker();
    const tab=tabs.find(t=>t.id===tabId);
    if(!tab||tab.progKey===nuevoPk){return;}
