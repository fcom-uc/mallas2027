function cambiarColorEtiquetaEditor(key,col){
    const fg=contrastColor(col);
    if(!etiquetaStyles[key])etiquetaStyles[key]={};
    etiquetaStyles[key].bg=col;etiquetaStyles[key].fg=fg;
    const sw=document.getElementById('etiq-fg-'+CSS.escape(key));
    if(sw)sw.style.background=fg;
    aplicarCSSVariables();
    tabs.forEach(t=>actualizarStatsEtiquetas(t.id));
    if(!db.Config)db.Config={};
    db.Config.EtiquetaStyles=JSON.parse(JSON.stringify(etiquetaStyles));
    db.Config.EtiquetaOrder=[...etiquetaOrder];
    programarGuardado();
}
function renombrarEtiqueta(orig,nuevo,inputEl){
    nuevo=(nuevo||'').trim().toLowerCase().replace(/\s+/g,'_');
    if(!nuevo||nuevo===orig){if(inputEl)inputEl.value=orig;return;}
    if(etiquetaStyles[nuevo]){alert('Ya existe una etiqueta con ese nombre.');if(inputEl)inputEl.value=orig;return;}
    etiquetaStyles[nuevo]=etiquetaStyles[orig];delete etiquetaStyles[orig];
    const idx=etiquetaOrder.indexOf(orig);if(idx>=0)etiquetaOrder[idx]=nuevo;
    PROG_KEYS.forEach(pk=>{
        Object.values(db.Programas[pk].Cursos||{}).forEach(loc=>{
            if((loc.Etiqueta||'').toLowerCase()===orig)loc.Etiqueta=nuevo;
        });
    });
    if(inputEl){inputEl.value=nuevo;inputEl.dataset.orig=nuevo;}
    guardarConfigEtiquetas();renderEditorEtiquetas();
}
function agregarEtiqueta(){
    const nombre=(document.getElementById('etiq-nueva-nombre').value||'').trim().toLowerCase().replace(/\s+/g,'_');
    if(!nombre){document.getElementById('etiq-nueva-nombre').focus();return;}
    if(etiquetaStyles[nombre]){alert('Ya existe una etiqueta con ese nombre.');return;}
    const col=document.getElementById('etiq-nueva-color').value||'#3498db';
    etiquetaStyles[nombre]={bg:col,fg:contrastColor(col)};
    etiquetaOrder.push(nombre);
    document.getElementById('etiq-nueva-nombre').value='';
    guardarConfigEtiquetas();renderEditorEtiquetas();
}
function eliminarEtiqueta(key){
    const usosArr=[];
    PROG_KEYS.forEach(pk=>{
        Object.values(db.Programas[pk].Cursos||{}).forEach(loc=>{
            if((loc.Etiqueta||'').toLowerCase()===key)usosArr.push(pk);
        });
    });
    if(usosArr.length>0){
        if(!confirm('La etiqueta "'+key+'" está en uso en '+usosArr.length+' curso(s) ('+[...new Set(usosArr)].join(', ')+').\n¿Eliminarla? Los cursos quedarán sin etiqueta.'))return;
        PROG_KEYS.forEach(pk=>{
            Object.values(db.Programas[pk].Cursos||{}).forEach(loc=>{
                if((loc.Etiqueta||'').toLowerCase()===key)loc.Etiqueta='';
            });
        });
    }
    delete etiquetaStyles[key];
    etiquetaOrder=etiquetaOrder.filter(k=>k!==key);
    guardarConfigEtiquetas();renderEditorEtiquetas();
}
