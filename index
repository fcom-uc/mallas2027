function inicializarTabs(){
    const w=document.getElementById('tab-content-wrapper');
    w.innerHTML='';tabs=[];
    PROG_KEYS.slice(0,6).forEach((key,idx)=>{
        const id=nextTabId++;
        tabs.push({id,progKey:key,backlogVisible:true,sortables:[]});
        const panel=document.createElement('div');
        panel.className='tab-panel'+(idx===0?' active':'');
        panel.id='panel-'+id;
        w.appendChild(panel);
    });
    activeTabId=tabs[0].id;
    renderTabStrip();
    tabs.forEach(t=>buildWorkspace(t.id));
}

function activateTab(id){
    cerrarMenus();
    activeTabId=id;
    document.querySelectorAll('.tab-panel').forEach(p=>p.classList.remove('active'));
    document.getElementById('panel-'+id)?.classList.add('active');
    renderTabStrip();
}

/* Renderiza la tira de pestañas.
   La pestaña activa se convierte en botón con menú desplegable. */
function renderTabStrip(){
    const strip=document.getElementById('tabs-strip');
    strip.innerHTML='';
    tabs.forEach(tab=>{
        const prog=db?.Programas?.[tab.progKey];
        const label=prog?.Nombre||tab.progKey;
        const btn=document.createElement('button');
        btn.className='tab-btn'+(tab.id===activeTabId?' active':'');
        btn.textContent=label;
        btn.onclick=()=>activateTab(tab.id);
        if(tab.id===activeTabId){
            // Variante Vigente: no permite cambiar el programa de la pestaña
            btn.title='Doble clic para cambiar programa';
        }
        strip.appendChild(btn);
    });
    // Variante Vigente: no se muestra el botón de agregar pestaña (solo lectura)
}

