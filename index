/* Abre el PDF desde la carpeta vinculada; si falla, cae en la ruta normal */
async function abrirProgramaLocal(cod,urlFallback){
    const dir=dirProgramas;                 // fijar el handle por si cambia durante la espera
    if(!dir){window.open(urlFallback,'_blank');return;}
    try{
        if(dir.queryPermission){
            let perm=await dir.queryPermission({mode:'read'});
            if(perm!=='granted')perm=await dir.requestPermission({mode:'read'});
            if(perm!=='granted'){window.open(urlFallback,'_blank');return;}
        }
        const fh=await dir.getFileHandle(cod+'.pdf');
        const f=await fh.getFile();
        const url=URL.createObjectURL(f);
        const w=window.open(url,'_blank');
        if(!w){URL.revokeObjectURL(url);window.open(urlFallback,'_blank');return;}
        setTimeout(()=>URL.revokeObjectURL(url),60000);
    }catch(e){
        if(e&&e.name==='NotFoundError'){
            alert('No se encontró "'+cod+'.pdf" en la carpeta vinculada ('+dir.name+').');
            return;
        }
        console.warn(e);
        window.open(urlFallback,'_blank');
    }
}

