function guardarModal(){return;// Variante Vigente: sin edición

    if(!_modalCodigo||!_modalTabId){cerrarModal();return;}
    const tab=tabs.find(t=>t.id===_modalTabId);
    const nuevoCod=document.getElementById('m-codigo').value.trim();
