function detectarCiclos(tabId){
    const tab=tabs.find(t=>t.id===tabId);
    const lista=cursosDelPrograma(tab.progKey);
    const COLOR={};lista.forEach(c=>{COLOR[c.Codigo]='blanco';});
    const enCiclo=new Set();
    function dfs(cod,pila){
        COLOR[cod]='gris';pila.push(cod);
        (lista.find(c=>c.Codigo===cod)?.Prerrequisitos||[]).forEach(req=>{
            if(!COLOR[req])return;
            if(COLOR[req]==='gris'){const i=pila.indexOf(req);for(let j=i;j<pila.length;j++)enCiclo.add(pila[j]);}
            else if(COLOR[req]==='blanco')dfs(req,pila);
        });
        pila.pop();COLOR[cod]='negro';
    }
    lista.forEach(c=>{if(COLOR[c.Codigo]==='blanco')dfs(c.Codigo,[]);});
    document.querySelectorAll('#panel-'+tabId+' .curso-card').forEach(card=>
        card.classList.toggle('ciclo-requisito',enCiclo.has(card.getAttribute('data-codigo'))));
}

let vistaModo='malla';   // 'malla' | 'impacto' | 'grafo'
let impactoActivo=false; // derivado: true sólo en modo 'impacto'
function setVista(modo){
